# Optional for local development. Use Neon's pooled connection string for deployed functions.
# Without this value, the API queries NASA directly.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exora

# Production catalog scheduling only. Vercel sends CRON_SECRET to the protected trigger, which
# uses the fine-grained GitHub token to dispatch the external catalog-refresh workflow.
CRON_SECRET=
CATALOG_SYNC_GITHUB_TOKEN=

# API listener port.
PORT=8787

# Variant Launch project key for iPhone immersive AR. Authorize the deployed hostname in the
# Variant Launch dashboard. When omitted, the SDK is not added to the website.
VITE_VARIANT_LAUNCH_KEY=
