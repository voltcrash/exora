# API listener port.
PORT=8787
# Header a reverse proxy in front of the Node server overwrites with the caller's address, such as
# x-real-ip. Leave empty when the server is reached directly; every caller then shares one budget.
TRUSTED_CLIENT_IP_HEADER=

# Variant Launch project key for iPhone immersive AR. Authorize the deployed hostname in the
# Variant Launch dashboard. When omitted, the SDK is not added to the website.
VITE_VARIANT_LAUNCH_KEY=
