{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vp run website#build && vp run @exora/api#build",
  "outputDirectory": "apps/website/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "apps/api/dist/vercel.mjs",
      "maxDuration": 30,
      "regions": ["sin1"]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ]
}
