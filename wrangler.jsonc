// Build first with `vp run -r build`; `vp run deploy` does both.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exora",
  "main": "apps/api/dist/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "exora.voltcrash.com", "custom_domain": true }],
  "assets": {
    "directory": "apps/website/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only API calls start the Worker; every other path is a free static-asset request.
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
}
