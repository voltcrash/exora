{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build && node scripts/check-performance-budget.ts && node scripts/check-discovery.ts",
    "quality:seo": "node scripts/check-discovery.ts",
    "quality:bundle": "node scripts/check-performance-budget.ts",
    "star-catalog": "node scripts/build-star-catalog.ts",
    "preview": "vp preview",
    "quality:lighthouse": "lhci autorun && LIGHTHOUSE_PROFILE=mobile lhci autorun",
    "test": "vp test --project unit",
    "test:browser:desktop": "BROWSER_PROFILE=desktop vp test --project browser",
    "test:browser:full": "BROWSER_PROFILE=full vp test --project browser"
  },
  "dependencies": {
    "@babylonjs/core": "catalog:",
