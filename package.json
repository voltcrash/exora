{
  "name": "exora",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "quality:assets": "node scripts/check-asset-provenance.mjs",
    "quality:lighthouse": "vp run website#quality:lighthouse",
    "deploy": "vp run -r build && vp exec wrangler deploy",
    "deploy:check": "vp exec wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "vp run --parallel --filter website --filter @exora/api dev",
    "dev:api": "vp run @exora/api#dev",
    "dev:web": "vp run website#dev",
    "prepare": "vp config",
    "preview": "vp exec wrangler dev --local --ip 127.0.0.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.16.1"
}
