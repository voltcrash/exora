{
  "name": "exora",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "quality:assets": "node scripts/check-asset-provenance.mjs",
    "quality:lighthouse": "vp run website#quality:lighthouse",
    "dev": "vp run --parallel --filter website --filter @exora/api dev",
    "dev:vercel": "vercel dev",
    "dev:api": "vp run @exora/api#dev",
    "dev:web": "vp run website#dev",
    "deploy": "vercel",
    "deploy:prod": "vercel --prod",
    "db:migrate": "vp run @exora/api#db:migrate",
    "db:sync": "vp run @exora/api#db:sync",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vercel": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.21.0"
}
